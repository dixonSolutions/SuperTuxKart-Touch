<component type="desktop-application">
  <id>io.github.dixonSolutions.SuperTuxKartTouch</id>
  <name>SuperTuxTouch</name>
  <summary>Touch-first SuperTuxKart for Linux tablets and phones (separate from Flathub SuperTuxKart)</summary>
  <keywords>
    <keyword>touch</keyword>
    <keyword>tablet</keyword>
    <keyword>SuperTuxTouch</keyword>
    <keyword>supertuxtouch</keyword>
